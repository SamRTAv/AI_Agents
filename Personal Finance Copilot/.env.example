# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real keys.

# ---------------------------------------------------------------
# LLM  ("groq" or "openai")
# ---------------------------------------------------------------
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
#
# TOOL CALLING MATTERS MORE THAN SIZE HERE.
# llama-3.3-70b-versatile fails on this agent: it emits function calls as text
# ("<function=search_finance_docs{...}</function>") instead of structured
# tool_calls, and Groq rejects it with `tool_use_failed`. Use a model built for
# agentic tool use. Verify ids at https://console.groq.com/docs/models
#   openai/gpt-oss-120b          strongest tool-caller on Groq
#   moonshotai/kimi-k2-instruct  built for agentic use
#   qwen/qwen3-32b               smaller fallback
GROQ_MODEL=openai/gpt-oss-120b

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------
# Embeddings (phase 4)  "huggingface" = free + local, "openai" = paid + tiny
# Groq does NOT serve embeddings, so this is always a separate provider.
# ---------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------
# LangSmith  (https://smith.langchain.com -> Settings -> API Keys)
# These exact names are read by the langsmith SDK itself.
# ---------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=personal-finance-copilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
